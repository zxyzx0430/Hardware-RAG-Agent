# Week 1 对照：
# - Day 1：让小白知道“配置不要写死在代码里”
# - Day 3：LLM 的默认 Key / Base URL / Model 从这里提供样例
# - Day 5：Web 服务端口也应该有可调整的默认值

# ─── LLM ───
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096


# ─── Chroma ───
CHROMA_PERSIST_DIR=data/chroma
# 部署模式：persistent（嵌入式，默认）/ http（需另起 chroma server）
CHROMA_MODE=persistent
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# ─── SQLite ───
SQLITE_DB_PATH=data/chat_history.db

# Embedding (阿里云 dashscope，不配置则跳过向量化)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ─── Server ───
# 默认只监听本地（安全）；如需局域网访问可改 0.0.0.0
HOST=127.0.0.1
PORT=8000

# ─── Logging ───
LOG_LEVEL=INFO
