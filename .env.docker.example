# Hardware RAG Agent — Docker 环境变量样例
# 使用方法：复制为 backend/.env 并填入实际值
#   cp .env.docker.example backend/.env
# 注意：实际 .env 必须放在 backend/ 下（对齐 settings.py 的 ROOT_DIR）

# ═══ LLM 配置（必填）═══
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ═══ Embedding 配置（必填）═══
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ═══ 服务配置（Docker 内置默认值，通常无需修改）═══
HOST=0.0.0.0
# dev profile 用 58080（对齐 vite.config.ts proxy）
# prod profile 用 8000（标准端口）
# compose 会覆盖此值，这里仅作参考
PORT=8000
CHROMA_MODE=persistent
LOG_LEVEL=INFO
HF_ENDPOINT=https://hf-mirror.com

# ═══ Docker 构建参数 ═══
# OCR 支持（可选，约 1.5GB）：
#   docker build --build-arg INSTALL_OCR=true -t hwrag-ocr .
# 默认不含 OCR，PDF 内嵌图片文字提取功能关闭（OCR_ENABLED=False）
