# Hardware RAG Agent — Environment Configuration Template
# Copy this file to .env and fill in your own values.

# ─────────────────────────────────────────────
# LLM (OpenAI-compatible API)
# ─────────────────────────────────────────────
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=58080
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Chroma (Vector DB)
#   persistent = embedded mode (default, no extra process)
#   http       = requires running `chroma run --host 127.0.0.1 --port 8001`
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma
CHROMA_MODE=persistent
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─────────────────────────────────────────────
# SQLite (Chat history + Token usage)
# ─────────────────────────────────────────────
SQLITE_DB_PATH=data/chat_history.db

# ─────────────────────────────────────────────
# Embedding (OpenAI-compatible API)
# ─────────────────────────────────────────────
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=10

# ─────────────────────────────────────────────
# Reranker (BAAI/bge-reranker-base)
#   Cross-encoder reranking for hybrid retrieval.
#   Model auto-downloads on first backend start (~280MB).
# ─────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MIN_SCORE=-2.0
RERANKER_MIN_KEEP=2
RERANKER_RETRY_INTERVAL_SEC=300

# ─────────────────────────────────────────────
# OCR (PaddleOCR) — off by default
#   Enable to extract text from images embedded in PDF/DOCX.
# ─────────────────────────────────────────────
OCR_ENABLED=False
OCR_LANG=ch

# ─────────────────────────────────────────────
# BM25 (Keyword recall)
# ─────────────────────────────────────────────
BM25_K1=1.5
BM25_B=0.75

# ─────────────────────────────────────────────
# HNSW (ChromaDB vector index)
# ─────────────────────────────────────────────
HNSW_EF_SEARCH=200

# ─────────────────────────────────────────────
# Agent (LangGraph)
# ─────────────────────────────────────────────
AGENT_CHECKPOINTER_TYPE=sqlite

# Tavily (Optional — used by web_search Agent tool)
#   Free tier: 1000 requests/month
#   Get key: https://tavily.com
#   Leave empty to disable web_search; Agent will fall back to local KB.
TAVILY_API_KEY=

# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────
MAX_ATTACHMENT_CHARS=8000
CHUNKING_TIMEOUT_SEC=300
METRICS_ENABLED=True
HF_ENDPOINT=https://hf-mirror.com
