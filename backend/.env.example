# Hardware RAG Agent — Environment Configuration Template
# Copy this file to .env and fill in your own values.

# ─────────────────────────────────────────────
# LLM (OpenAI-compatible API)
# ─────────────────────────────────────────────
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─────────────────────────────────────────────
# Chroma (Vector DB)
#   persistent = embedded mode (default, no extra process)
#   http       = requires running `chroma run --host 127.0.0.1 --port 8001`
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma
CHROMA_MODE=persistent

# ─────────────────────────────────────────────
# SQLite (Chat history + Token usage)
# ─────────────────────────────────────────────
SQLITE_DB_PATH=data/chat_history.db

# ─────────────────────────────────────────────
# Embedding (OpenAI-compatible API)
# ─────────────────────────────────────────────
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# Tavily (Optional — used by web_search Agent tool)
#   Free tier: 1000 requests/month
#   Get key: https://tavily.com
#   Leave empty to disable web_search; Agent will fall back to local KB.
# ─────────────────────────────────────────────
TAVILY_API_KEY=
